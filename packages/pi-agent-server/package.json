{
  "name": "@mkagent/pi-agent-server",
  "version": "0.2.6",
  "license": "Apache-2.0",
  "description": "Out-of-process Pi agent server communicating via JSONL over stdio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-agent-server": "./dist/index.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun run --cwd ../pi-durable-coding build:types && tsc --noEmit -p tsconfig.typecheck.json",
    "validate": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@mkagent/pi-durable-coding": "workspace:*",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "duck-duck-scrape": "^2.2.7",
    "node-html-parser": "^6.1.0",
    "pdfjs-dist": "^5.4.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
